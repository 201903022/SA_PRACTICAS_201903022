generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_codes {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String         @db.Uuid
  code_hash    String         @db.VarChar(255)
  type         auth_code_type
  attempts     Int            @default(0)
  max_attempts Int            @default(5)
  expires_at   DateTime       @db.Timestamptz(6)
  used_at      DateTime?      @db.Timestamptz(6)
  destination  String?        @db.VarChar(320)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  users        users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_auth_codes_user")

  @@index([expires_at], map: "idx_auth_codes_expires_at")
  @@index([user_id], map: "idx_auth_codes_user_id")
}

model roles {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(30)
  description String   @db.VarChar(255)
  is_system   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users[]
}

model users {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String       @unique @db.VarChar(320)
  password       String       @db.VarChar(255)
  name           String       @db.VarChar(120)
  phone_number   String?      @db.VarChar(20)
  role_id        String       @db.Uuid
  is_active      Boolean      @default(true)
  email_verified Boolean      @default(false)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  auth_codes     auth_codes[]
  roles          roles        @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "fk_auth_users_role")
}

enum auth_code_type {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
}
