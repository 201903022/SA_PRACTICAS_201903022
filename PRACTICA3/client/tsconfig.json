{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"], // Permite usar window, document, etc.
    "module": "ESNext", // Vite prefiere ESNext sobre NodeNext para el bundling
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler", // Optimizado para herramientas como Vite
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true, // Vite se encarga de la compilación, TS solo checa errores
    "jsx": "react-jsx",

    /* Linting / Strict */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true, // FUNDAMENTAL para tu migración progresiva
    "esModuleInterop": true // Evita errores al importar librerías JS viejas
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/vite-env.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
