generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/orders-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_ORDERS")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id           String  @db.Uuid
  menu_item_id       String  @db.Uuid
  item_name_snapshot String  @db.VarChar(120)
  unit_price         Decimal @db.Decimal(12, 2)
  quantity           Int
  line_total         Decimal @db.Decimal(12, 2)
  orders             orders  @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_order_items_order")

  @@index([menu_item_id], map: "idx_order_items_menu_item_id")
  @@index([order_id], map: "idx_order_items_order_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_user_id         String                      @db.Uuid
  restaurant_id            String                      @db.Uuid
  status                   Unsupported("order_status") @default(dbgenerated("'CREATED'::public.order_status"))
  restaurant_name_snapshot String                      @db.VarChar(120)
  delivery_address         String                      @db.VarChar(255)
  total_amount             Decimal                     @db.Decimal(12, 2)
  currency                 String                      @default("GTQ") @db.Char(3)
  canceled_at              DateTime?                   @db.Timestamptz(6)
  canceled_by_user_id      String?                     @db.Uuid
  rejection_reason         String?
  created_at               DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                    @default(now()) @db.Timestamptz(6)
  order_items              order_items[]

  @@index([created_at], map: "idx_orders_created_at")
  @@index([customer_user_id], map: "idx_orders_customer_user_id")
  @@index([restaurant_id], map: "idx_orders_restaurant_id")
  @@index([status], map: "idx_orders_status")
}
