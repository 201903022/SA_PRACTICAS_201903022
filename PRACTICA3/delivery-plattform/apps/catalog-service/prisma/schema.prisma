generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/catalog-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_CATALOGO")
}

model menu_item_categories {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id          String                   @db.Uuid
  name                   String                   @db.VarChar(80)
  description            String?                  @db.VarChar(255)
  is_active              Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  restaurants            restaurants              @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_mic_restaurant")
  menu_item_category_map menu_item_category_map[]

  @@unique([restaurant_id, name], map: "uq_catalog_mic_restaurant_name")
  @@index([is_active], map: "idx_catalog_mic_is_active")
  @@index([restaurant_id], map: "idx_catalog_mic_restaurant_id")
}

model menu_item_category_map {
  menu_item_id         String               @db.Uuid
  category_id          String               @db.Uuid
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  menu_item_categories menu_item_categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_micm_category")
  menu_items           menu_items           @relation(fields: [menu_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_micm_menu_item")

  @@id([menu_item_id, category_id], map: "pk_catalog_menu_item_category_map")
  @@index([category_id], map: "idx_catalog_micm_category_id")
  @@index([menu_item_id], map: "idx_catalog_micm_menu_item_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model menu_items {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id          String                   @db.Uuid
  name                   String                   @db.VarChar(120)
  description            String?
  price                  Decimal                  @db.Decimal(12, 2)
  currency               String                   @default("GTQ") @db.Char(3)
  is_available           Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  menu_item_category_map menu_item_category_map[]
  restaurants            restaurants              @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_menu_items_restaurant")

  @@index([is_available], map: "idx_catalog_menu_items_is_available")
  @@index([restaurant_id], map: "idx_catalog_menu_items_restaurant_id")
}

model merchant_types {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String        @unique @db.VarChar(30)
  name        String        @db.VarChar(100)
  description String?       @db.VarChar(255)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)
  restaurants restaurants[]
}

model restaurant_categories {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                    @unique @db.VarChar(80)
  description             String?                   @db.VarChar(255)
  is_active               Boolean                   @default(true)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  restaurant_category_map restaurant_category_map[]
}

model restaurant_category_map {
  restaurant_id         String                @db.Uuid
  category_id           String                @db.Uuid
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  restaurant_categories restaurant_categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_rcm_category")
  restaurants           restaurants           @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_rcm_restaurant")

  @@id([restaurant_id, category_id], map: "pk_catalog_restaurant_category_map")
  @@index([category_id], map: "idx_catalog_rcm_category_id")
  @@index([restaurant_id], map: "idx_catalog_rcm_restaurant_id")
}

model restaurants {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                    @db.VarChar(120)
  address                 String                    @db.VarChar(255)
  phone                   String?                   @db.VarChar(20)
  alias                   String?                   @db.VarChar(80)
  opening_hours           String?                   @db.VarChar(120)
  is_active               Boolean                   @default(true)
  merchant_type_id        String                    @db.Uuid
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  owner_user_id           String?                   @db.Uuid
  menu_item_categories    menu_item_categories[]
  menu_items              menu_items[]
  restaurant_category_map restaurant_category_map[]
  merchant_types          merchant_types            @relation(fields: [merchant_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_catalog_restaurants_merchant_type")

  @@index([is_active], map: "idx_catalog_restaurants_is_active")
  @@index([merchant_type_id], map: "idx_catalog_restaurants_merchant_type_id")
  @@index([owner_user_id], map: "idx_catalog_restaurants_owner_user_id")
}
